	column GrupaWiekowa
		dataType: string
		lineageTag: 01003e54-2b3c-4bd5-abde-39e3c5ebe65d
		summarizeBy: none
		sourceColumn: GrupaWiekowa
		sortByColumn: GrupaWiekowaSort

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column GrupaWiekowaSort
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 61769270-68f2-42ea-8869-f035d1ea05cd
		summarizeBy: sum
		sourceColumn: GrupaWiekowaSort

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column PlecOpis =
			
			SWITCH(
			    DimPacjent[Plec],
			    "K", "Kobiety",
			    "M", "Mężczyźni",
			    "Nieokreślona"
			)
		lineageTag: d8ba0674-b4d3-43ab-83b5-81adea16b7fa
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition DimPacjent = m
		mode: import
		source =
				let
				  Źródło = Sql.Database("localhost", "PoradniaDB"),
				  #"Nawigacja 1" = Źródło{[Schema = "dbo", Item = "Pacjent"]}[Data],
				  #"Usunięto kolumny" = Table.RemoveColumns(#"Nawigacja 1", {"PESEL", "Adres", "Telefon", "Email"}),
				  #"Dodano niestandardowe" = Table.TransformColumnTypes(Table.AddColumn(#"Usunięto kolumny", "Wiek", each let
				    DataOdniesienia = #date(2025, 6, 30),
				    WiekPodstawowy = Date.Year(DataOdniesienia) - Date.Year([DataUrodzenia]),
				    UrodzinyWtymRoku = #date(
				        Date.Year(DataOdniesienia),
				        Date.Month([DataUrodzenia]),
				        Date.Day([DataUrodzenia])
				    )
				in
				    if UrodzinyWtymRoku > DataOdniesienia
				    then WiekPodstawowy - 1
				    else WiekPodstawowy), {{"Wiek", Int64.Type}}),
				  #"Dodano niestandardowe 1" = Table.TransformColumnTypes(Table.AddColumn(#"Dodano niestandardowe", "GrupaWiekowa", each if [Wiek] >= 18 and [Wiek] <= 24 then "18–24"
				else if [Wiek] <= 39 then "25–39"
				else if [Wiek] <= 60 then "40–60"
				else "61+"), {{"GrupaWiekowa", type text}}),
				  #"Wstawiono kolumnę warunkową" = Table.AddColumn(#"Dodano niestandardowe 1", "GrupaWiekowaSort", each if [Wiek] <= 24 then 1 else if [Wiek] <= 39 then 2 else if [Wiek] <= 60 then 3 else 4),
				  #"Zmieniono typ kolumny" = Table.TransformColumnTypes(#"Wstawiono kolumnę warunkową", {{"GrupaWiekowaSort", Int64.Type}}),
				  #"Zmieniono kolejność kolumn" = Table.ReorderColumns(#"Zmieniono typ kolumny", {"PacjentID", "Imie", "Nazwisko", "DataUrodzenia", "Plec", "Wiek", "GrupaWiekowa", "GrupaWiekowaSort", "Wizyta"}),
				  #"Usunięto kolumny 1" = Table.RemoveColumns(#"Zmieniono kolejność kolumn", {"Wizyta"})
				in
				  #"Usunięto kolumny 1"

	annotation PBI_ResultType = Table

