table Miary
	lineageTag: 3eb5f0d3-6924-4880-9189-83abc33d82be

	measure 'Liczba wizyt' =
			
			COUNTROWS(FactWizyta)
		formatString: 0
		lineageTag: 36911370-20b6-4df9-8cf3-4f4a846971f0

		changedProperty = IsHidden

	measure 'Wizyty zrealizowane' =
			
			CALCULATE(
			    [Liczba wizyt],
			    FactWizyta[StatusWizytyID] = 2
			)
		formatString: 0
		lineageTag: 14eb2e8c-119d-406d-8b29-94e368b2b0fc

		changedProperty = IsHidden

	measure 'Wizyty anulowane' =
			
			CALCULATE(
			    [Liczba wizyt],
			    FactWizyta[StatusWizytyID] = 3
			)
		formatString: 0
		lineageTag: d322e074-808b-445b-8a74-8543ecc66ba2

		changedProperty = IsHidden

	measure 'Aktywni pacjenci' =
			
			CALCULATE(
			    DISTINCTCOUNT(FactWizyta[PacjentID]),
			    FactWizyta[StatusWizytyID] = 2
			)
		formatString: 0
		lineageTag: fa0c63e7-3551-48db-8288-ecd49f8ae26e

	measure 'Wskaźnik anulowań' =
			
			DIVIDE(
			    [Wizyty anulowane],
			    [Wizyty zrealizowane] + [Wizyty anulowane]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c12d7582-2254-4adb-8f64-caca674e2a87

	measure Przychód =
			
			CALCULATE(
			    SUM(FactWizyta[Kwota]),
			    FactWizyta[StatusWizytyID] = 2,
			    USERELATIONSHIP(
			        DimData[Data],
			        FactWizyta[DataPlatnosciData]
			    )
			)
		formatString: #,0.00\ "zł";-#,0.00\ "zł";#,0.00\ "zł"
		lineageTag: 26738345-ffaf-4875-a656-8f7eb441b76c

		annotation PBI_FormatHint = {"currencyCulture":"pl-PL"}

	measure 'Wartość zrealizowanych usług' =
			
			CALCULATE(
			    SUM(FactWizyta[Kwota]),
			    FactWizyta[StatusWizytyID] = 2
			)
		formatString: #,0.00\ "zł";-#,0.00\ "zł";#,0.00\ "zł"
		lineageTag: 5dce4755-58b7-4a63-a2f0-c67b4bd28cd6

		annotation PBI_FormatHint = {"currencyCulture":"pl-PL"}

	measure 'Średnia wartość wizyty' =
			
			DIVIDE(
			    [Wartość zrealizowanych usług],
			    [Wizyty zrealizowane]
			)
		formatString: #,0.00\ "zł";-#,0.00\ "zł";#,0.00\ "zł"
		lineageTag: b0f08478-f472-4a57-b566-4e92b7d69381

		annotation PBI_FormatHint = {"currencyCulture":"pl-PL"}

	measure 'Średnia wizyt na pacjenta' =
			
			DIVIDE(
			    [Wizyty zrealizowane],
			    [Aktywni pacjenci]
			)
		formatString: 0.00
		lineageTag: 5597c13b-b81e-4e04-a14e-70a1363e89b6

	measure 'Liczba pacjentów' =
			
			COUNTROWS(DimPacjent)
		formatString: 0
		lineageTag: b9e07924-865f-49a4-8de4-683c15982524

	measure 'Pacjenci powracający' =
			
			VAR DataKonca = MAX(DimData[Data])
			RETURN
			    COUNTROWS(
			        FILTER(
			            VALUES(DimPacjent[PacjentID]),
			            CALCULATE([Wizyty zrealizowane]) > 0
			                &&
			            CALCULATE(
			                [Wizyty zrealizowane],
			                REMOVEFILTERS(DimData),
			                FactWizyta[DataWizytyData] <= DataKonca
			            ) >= 2
			        )
			    )
		formatString: 0
		lineageTag: 2fdaf92b-8284-4c47-969f-bfdba34fd247

	measure 'Udział pacjentów powracających' =
			
			DIVIDE(
			    [Pacjenci powracający],
			    [Aktywni pacjenci]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7e1858a6-0eee-44e6-83a9-76833a6b940a

	measure 'Wskaźnik anulowań poradni' =
			
			CALCULATE(
			    [Wskaźnik anulowań],
			    REMOVEFILTERS(DimSpecjalizacja),
			    REMOVEFILTERS(DimLekarz)
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 72037a51-17ec-49f7-8eb3-0c52ca6f6460

	measure 'Średnia wizyt na lekarza – poradnia' =
			
			VAR LiczbaWizyt =
			    CALCULATE(
			        [Wizyty zrealizowane],
			        REMOVEFILTERS(DimLekarz),
			        REMOVEFILTERS(DimSpecjalizacja)
			    )
			VAR LiczbaLekarzy =
			    CALCULATE(
			        DISTINCTCOUNT(DimLekarz[LekarzID]),
			        REMOVEFILTERS(DimLekarz),
			        REMOVEFILTERS(DimSpecjalizacja)
			    )
			RETURN
			    DIVIDE(LiczbaWizyt, LiczbaLekarzy)
		formatString: 0.00
		lineageTag: 0ea9a507-39f2-4f0f-9080-103c43657270

	measure 'Wizyty zrealizowane – specjalizacja' =
			
			CALCULATE(
			    [Wizyty zrealizowane],
			    REMOVEFILTERS(DimTypWizyty)
			)
		formatString: 0
		lineageTag: d031961e-6e72-4324-98a0-c437decf764f

	measure 'Udział typu wizyty' =
			
			DIVIDE(
			    [Wizyty zrealizowane],
			    CALCULATE(
			        [Wizyty zrealizowane],
			        REMOVEFILTERS(DimTypWizyty)
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bce5eb7c-dd54-45f6-8ea0-39b7a0989130

	column Pomocnicza
		dataType: string
		isHidden
		lineageTag: 5e8223e8-fce4-4149-8f01-7baca82e5c0f
		summarizeBy: none
		sourceColumn: Pomocnicza

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition Miary = m
		mode: import
		source =
				let
				  Źródło = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Pomocnicza = _t])
				in
				  Źródło

	annotation PBI_ResultType = Table

